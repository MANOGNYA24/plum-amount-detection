{
  "info": {
    "name": "Amount Detection API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000"
    }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{base_url}}/health",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "health"
          ]
        }
      }
    },
    {
      "name": "Step 1 - Extract (text)",
      "request": {
        "method": "POST",
        "url": {
          "raw": "{{base_url}}/api/v1/extract",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "extract"
          ]
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"text\": \"Total: INR 1200 | Paid: 1000 | Due: 200 | Discount: 10%\"}"
        }
      }
    },
    {
      "name": "Step 2 - Normalize (noisy)",
      "request": {
        "method": "POST",
        "url": {
          "raw": "{{base_url}}/api/v1/normalize",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "normalize"
          ]
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"text\": \"T0tal: Rs l200 | Pald: 1000 | Due: 200\"}"
        }
      }
    },
    {
      "name": "Step 3 - Classify",
      "request": {
        "method": "POST",
        "url": {
          "raw": "{{base_url}}/api/v1/classify",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "classify"
          ]
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"text\": \"Total: INR 1200 | Paid: 1000 | Due: 200 | Discount: 10%\"}"
        }
      }
    },
    {
      "name": "Step 4 - Detect (text)",
      "request": {
        "method": "POST",
        "url": {
          "raw": "{{base_url}}/api/v1/detect",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "detect"
          ]
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"text\": \"Total: INR 1200 | Paid: 1000 | Due: 200 | Discount: 10%\"}"
        }
      }
    },
    {
      "name": "Step 4 - Detect (noisy text)",
      "request": {
        "method": "POST",
        "url": {
          "raw": "{{base_url}}/api/v1/detect",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "detect"
          ]
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"text\": \"T0tal: Rs l200 | Pald: 1000 | Due: 200\"}"
        }
      }
    },
    {
      "name": "Step 4 - Detect (image) - pick samples/bill_noisy.jpg",
      "request": {
        "method": "POST",
        "url": {
          "raw": "{{base_url}}/api/v1/detect",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "detect"
          ]
        },
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "file",
              "type": "file",
              "src": "samples/bill_noisy.jpg"
            }
          ]
        }
      }
    },
    {
      "name": "Detect with debug",
      "request": {
        "method": "POST",
        "url": {
          "raw": "{{base_url}}/api/v1/detect?debug=true",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "detect"
          ],
          "query": [
            {
              "key": "debug",
              "value": "true"
            }
          ]
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"text\": \"Total: INR 1200 | Paid: 1000 | Due: 200 | Discount: 10%\"}"
        }
      }
    },
    {
      "name": "Guardrail - no amounts",
      "request": {
        "method": "POST",
        "url": {
          "raw": "{{base_url}}/api/v1/detect",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "detect"
          ]
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"text\": \"Thank you for visiting\"}"
        }
      }
    }
  ]
}